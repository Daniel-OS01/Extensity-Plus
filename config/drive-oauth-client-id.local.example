# Chrome extension OAuth client ID for Google Drive sync (gglcloud project).
# Copy this file to drive-oauth-client-id.local (gitignored) and replace the line below.
#
# Create credentials: Google Cloud Console → APIs & Services → Credentials
# → Create credentials → OAuth client ID → Application type: Chrome extension
# Create one Chrome Extension OAuth client for the runtime ID shown by the
# unpacked build. Unpacked IDs can change when the load path/profile changes.
# Do not reuse the Store-bound client for local development.
#
# Store builds receive their separate public client ID from
# vars.EXTENSITY_DRIVE_CLIENT_ID during the release workflow.
# Do NOT paste or store client_secret values.
REPLACE_WITH_LOCAL_CHROME_EXTENSION_CLIENT_ID.apps.googleusercontent.com
